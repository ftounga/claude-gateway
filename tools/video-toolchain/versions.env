# F-215 / SF-215-06 — versions épinglées du paquet de la chaîne vidéo servi par le portail.
# TOOLCHAIN_VERSION doit être égal à RenderToolchain.TOOLCHAIN_VERSION (runner) : le runner ne demande
# que cette version-là. Changer une version ci-dessous = nouvelle TOOLCHAIN_VERSION (-r2, -r3…),
# puis mettre à jour upstream.sha256, npm/package.json et npm/package-lock.json.
TOOLCHAIN_VERSION=0.8.193-r1
NODE_VERSION=22.22.1
HYPERFRAMES_VERSION=0.8.193
GSAP_VERSION=3.13.0
# ffmpeg/ffprobe statiques : https://github.com/eugeneware/ffmpeg-static/releases/tag/b6.1.1
FFMPEG_TAG=b6.1.1
