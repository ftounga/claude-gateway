<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      F-151 / SF-151-02 — LA CLE DE DEDOUBLONNAGE des actions inscrites par l'agent.

      POURQUOI : l'agent rencontre le meme blocage a chaque tour tant qu'il n'est pas leve. Sans cle,
      la liste de l'utilisateur se remplirait de dix fois « demander l'acces VPN a Karim ».

      ET SURTOUT : une action ANNULEE par l'utilisateur ne doit pas etre recreee. Sa parole prime.
      L'unicite porte donc sur (user_id, workspace_id, dedup_key) QUEL QUE SOIT LE STATUT — c'est
      exactement ce qui empeche la recreation.

      Nullable : les actions ajoutees a la main par l'utilisateur (SF-151-01) n'en ont pas, et
      plusieurs NULL cohabitent sans violer l'unicite (PostgreSQL comme H2).
    -->

    <changeSet id="131-terminal-actions-dedup-key" author="claude-gateway">
        <addColumn tableName="terminal_actions">
            <column name="dedup_key" type="varchar(200)"/>
        </addColumn>

        <createIndex tableName="terminal_actions" indexName="ux_terminal_actions_dedup" unique="true">
            <column name="user_id"/>
            <column name="workspace_id"/>
            <column name="dedup_key"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
