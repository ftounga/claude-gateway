<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      F-177 / SF-177-02 - L'AGENT PROPOSE, L'UTILISATEUR VALIDE.

      Une ligne par proposition de gouvernance faite par l'agent (outil gouvernance_proposer) : une
      REGLE (section de GOUVERNANCE.md), un SKILL (.claude/skills/<nom>.md) ou un GABARIT
      (.claude/gabarits/<nom>.md), portee POSTE (racine du poste) ou SUJET (dossier du projet).

      La proposition N'ECRIT RIEN : elle garde le contenu complet a ecrire et l'empreinte du fichier
      au moment de la proposition (base_digest, 'ABSENT' si le fichier n'existait pas). [Appliquer]
      relit le fichier, refuse s'il a change depuis, ecrit via le runner, et trace applied_digest.

      Isolation : user_id sur chaque ligne ; toute lecture filtre user_id + workspace_id. Les lignes
      suivent le terminal (cle etrangere, cascade) et le compte (purge nommee).
      Rollback : la table se retire.
    -->

    <changeSet id="148-governance-proposals" author="claude-gateway">
        <createTable tableName="governance_proposals">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid"><constraints nullable="false"/></column>
            <column name="workspace_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_governance_proposals_workspace"
                             references="workspaces(id)" deleteCascade="true"/>
            </column>
            <column name="host_id" type="uuid"/>
            <!-- REGLE | SKILL | GABARIT -->
            <column name="type" type="varchar(16)"><constraints nullable="false"/></column>
            <!-- POSTE | SUJET -->
            <column name="scope" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="name" type="varchar(120)"><constraints nullable="false"/></column>
            <column name="path" type="varchar(300)"><constraints nullable="false"/></column>
            <column name="reason" type="varchar(1000)"/>
            <column name="content" type="varchar(1000000)"><constraints nullable="false"/></column>
            <column name="diff_json" type="varchar(1000000)"/>
            <column name="base_digest" type="varchar(80)"><constraints nullable="false"/></column>
            <!-- PENDING | APPLIED | REFUSED -->
            <column name="status" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="applied_digest" type="varchar(80)"/>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="decided_at" type="timestamptz"/>
        </createTable>
        <createIndex tableName="governance_proposals" indexName="idx_governance_proposals_user_workspace">
            <column name="user_id"/>
            <column name="workspace_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="governance_proposals"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
