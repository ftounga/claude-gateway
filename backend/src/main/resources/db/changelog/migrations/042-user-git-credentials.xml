<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Table `user_git_credentials` (F-31 / SF-31-01). Jeton d'accès GitHub de l'utilisateur, chiffré
      au repos par le mécanisme BYOK déjà en place (envelope encryption AWS KMS, SF-03-01) : AUCUN
      jeton en clair n'est stocké — seuls le blob chiffré (encrypted_data_key, cipher_iv, ciphertext,
      base64), les 4 derniers caractères (token_last4) et le compte GitHub associé (github_login,
      information publique) sont persistés.

      Table DÉDIÉE, et non extension de `user_api_keys` : cette dernière porte la clé Claude en
      production et son unicité est posée sur `user_id` seul ; y loger un second secret imposerait de
      modifier une contrainte vivante sur la fonctionnalité la plus critique du produit.

      `user_id` unique => au plus un jeton par utilisateur (isolation multi-tenant). Ids générés côté
      application (Hibernate @UuidGenerator). Changesets Postgres et H2 en parallèle.
      Réversible : la table est nouvelle, son rollback est un `dropTable` (aucune donnée existante).
    -->

    <!-- ============================ POSTGRESQL ============================ -->
    <changeSet id="042-user-git-credentials-postgresql" author="claude-gateway" dbms="postgresql">
        <createTable tableName="user_git_credentials">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_user_git_credentials_user_id"/>
            </column>
            <column name="github_login" type="varchar(100)"/>
            <column name="encrypted_data_key" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="cipher_iv" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="ciphertext" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="token_last4" type="varchar(4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="user_git_credentials" indexName="idx_user_git_credentials_user_id">
            <column name="user_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="user_git_credentials"/>
        </rollback>
    </changeSet>

    <!-- ================================ H2 ================================ -->
    <changeSet id="042-user-git-credentials-h2" author="claude-gateway" dbms="h2">
        <createTable tableName="user_git_credentials">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_user_git_credentials_user_id"/>
            </column>
            <column name="github_login" type="varchar(100)"/>
            <column name="encrypted_data_key" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="cipher_iv" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="ciphertext" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="token_last4" type="varchar(4)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="user_git_credentials" indexName="idx_user_git_credentials_user_id">
            <column name="user_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="user_git_credentials"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
