<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      F-243 / SF-243-01 - LES AGENDAS LUS PAR JARVIS (adresse iCal secrete de Google, chiffree au repos).

      jarvis_calendar_feeds : une ligne par agenda (10 au plus par compte, borne applicative). L'adresse iCal est
      chiffree par ByokKeyCipher (patron user_git_credentials : encrypted_data_key, cipher_iv, ciphertext, base64) ;
      seuls les 4 derniers caracteres (secret_last4) sont lisibles. url_hash = SHA-256 de l'adresse (unicite par compte
      sans rien reveler). Colonnes de releve : etag / last_modified (requete conditionnelle), content_hash (corps
      inchange => aucune analyse), expanded_at (la fenetre J-1 -> J+60 glisse), next_poll_at et lease_until (bail entre
      pods). Filtre user_id sur tout acces ; unicite (user_id, url_hash).

      Numero 243 = numero de la feature. Rollback : table retiree (nouvelle, sans donnee existante).
    -->

    <changeSet id="243-jarvis-calendar-feeds" author="claude-gateway">
        <createTable tableName="jarvis_calendar_feeds">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="uuid"><constraints nullable="false"/></column>
            <column name="label" type="varchar(40)"><constraints nullable="false"/></column>
            <column name="url_hash" type="varchar(64)"><constraints nullable="false"/></column>
            <column name="encrypted_data_key" type="varchar(1024)"><constraints nullable="false"/></column>
            <column name="cipher_iv" type="varchar(1024)"><constraints nullable="false"/></column>
            <column name="ciphertext" type="varchar(4096)"><constraints nullable="false"/></column>
            <column name="secret_last4" type="varchar(4)"><constraints nullable="false"/></column>
            <column name="status" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="etag" type="varchar(200)"/>
            <column name="last_modified" type="varchar(100)"/>
            <column name="content_hash" type="varchar(64)"/>
            <column name="event_count" type="int" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="last_ok_at" type="timestamp with time zone"/>
            <column name="expanded_at" type="timestamp with time zone"/>
            <column name="last_error" type="varchar(300)"/>
            <column name="next_poll_at" type="timestamp with time zone"/>
            <column name="lease_until" type="timestamp with time zone"/>
            <column name="created_at" type="timestamp with time zone"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="jarvis_calendar_feeds" columnNames="user_id, url_hash"
                             constraintName="uq_jarvis_calendar_feeds_user_url"/>
        <createIndex tableName="jarvis_calendar_feeds" indexName="idx_jarvis_calendar_feeds_next_poll">
            <column name="next_poll_at"/>
        </createIndex>
        <rollback>
            <dropTable tableName="jarvis_calendar_feeds"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
