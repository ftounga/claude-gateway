<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      F-232 / SF-232-03 - LE COMPAGNON ANDROID : APPAIRAGE, JETON DEDIE, ANNONCES TELEPHONE VERROUILLE.

      jarvis_companion_devices : un telephone appaire. token_hash = SHA-256 du jeton dedie (jamais le clair),
      limite a GET /companion/announcements. revoked_at non nul = jeton sans valeur.
      jarvis_companion_pairing_codes : code court a usage unique (hache), 10 minutes.
      jarvis_companion_announcements : ce que le telephone dit a voix haute (fin d'un tour ne a la voix, alerte de
      veille). Ecrites seulement si le compte a un telephone appaire ; purgees apres 2 jours.

      Isolation : user_id sur chaque ligne ; toute lecture sous user_id.
      Rollback : les trois tables se retirent.
    -->

    <changeSet id="192-jarvis-companion-devices" author="claude-gateway">
        <createTable tableName="jarvis_companion_devices">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="uuid"><constraints nullable="false"/></column>
            <column name="name" type="varchar(80)"><constraints nullable="false"/></column>
            <column name="token_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_jarvis_companion_devices_token"/>
            </column>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="last_seen_at" type="timestamptz"/>
            <column name="revoked_at" type="timestamptz"/>
        </createTable>
        <createIndex tableName="jarvis_companion_devices" indexName="idx_jarvis_companion_devices_user">
            <column name="user_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="jarvis_companion_devices"/>
        </rollback>
    </changeSet>

    <changeSet id="192-jarvis-companion-pairing-codes" author="claude-gateway">
        <createTable tableName="jarvis_companion_pairing_codes">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="uuid"><constraints nullable="false"/></column>
            <column name="code_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_jarvis_companion_codes_hash"/>
            </column>
            <column name="expires_at" type="timestamptz"><constraints nullable="false"/></column>
            <column name="consumed_at" type="timestamptz"/>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
        </createTable>
        <rollback>
            <dropTable tableName="jarvis_companion_pairing_codes"/>
        </rollback>
    </changeSet>

    <changeSet id="192-jarvis-companion-announcements" author="claude-gateway">
        <createTable tableName="jarvis_companion_announcements">
            <column name="id" type="uuid"><constraints primaryKey="true" nullable="false"/></column>
            <column name="user_id" type="uuid"><constraints nullable="false"/></column>
            <column name="kind" type="varchar(16)"><constraints nullable="false"/></column>
            <column name="text" type="varchar(600)"><constraints nullable="false"/></column>
            <column name="link" type="varchar(300)"><constraints nullable="false"/></column>
            <column name="created_at" type="timestamptz"><constraints nullable="false"/></column>
        </createTable>
        <createIndex tableName="jarvis_companion_announcements" indexName="idx_jarvis_companion_ann_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
        <rollback>
            <dropTable tableName="jarvis_companion_announcements"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
