<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      F-128 / SF-128-07 — RETENTION & PURGE DES MEDIAS DE REUNION.

      On horodate la purge des médias lourds (audio + images) d'une réunion, au-delà de retention_days :
        - media_purged_at : instant où les médias ont été purgés (stockage objet effacé, pointeurs vidés),
                            NULL tant qu'aucune purge. Marque l'idempotence (une réunion horodatée n'est
                            plus candidate) et permet à l'écran de dire « médias purgés le … ».
      L'ARTEFACT réunion et le TRANSCRIPT sont conservés ; seuls audio_key/audio_bytes/image_count sont
      vidés à la purge (colonnes existantes, SF-128-02/03).
      Additif et compatible : les réunions existantes prennent media_purged_at = NULL. Réversible.
    -->
    <changeSet id="116-meetings-media-purged-at" author="claude-gateway">
        <addColumn tableName="meetings">
            <column name="media_purged_at" type="timestamp with time zone"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="meetings" columnName="media_purged_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
