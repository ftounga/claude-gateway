<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      SF-31-05 — Le jeton GitHub de l'utilisateur gagne la référence du VAULT de credentials créé chez
      le fournisseur (F-31 / ADR-015). Le vault est ce qui permet au serveur MCP GitHub de s'authentifier
      et donc à l'agent de créer la pull request.

      AUCUN SECRET ICI. Ces deux colonnes ne portent que des identifiants opaques renvoyés par le
      fournisseur (« vlt_… », « vcrd_… ») : le PAT lui-même reste chiffré dans les colonnes existantes
      (encrypted_data_key / cipher_iv / ciphertext) et sa copie déposée chez le fournisseur est
      write-only — jamais relue, jamais renvoyée.

      Les deux colonnes sont NULLABLES : le vault est créé paresseusement, à la première session sur un
      dépôt Git. Un utilisateur qui n'a jamais ouvert de projet Git n'a donc rien déposé chez le
      fournisseur, et les lignes existantes restent valides sans reprise de données.

      Réversible : dropColumn.
    -->

    <!-- ============================ POSTGRESQL ============================ -->
    <changeSet id="045-user-git-credentials-mcp-vault-postgresql" author="claude-gateway" dbms="postgresql">
        <addColumn tableName="user_git_credentials">
            <column name="mcp_vault_id" type="varchar(64)"/>
            <column name="mcp_credential_id" type="varchar(64)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="user_git_credentials" columnName="mcp_vault_id"/>
            <dropColumn tableName="user_git_credentials" columnName="mcp_credential_id"/>
        </rollback>
    </changeSet>

    <!-- ================================ H2 ================================ -->
    <changeSet id="045-user-git-credentials-mcp-vault-h2" author="claude-gateway" dbms="h2">
        <addColumn tableName="user_git_credentials">
            <column name="mcp_vault_id" type="varchar(64)"/>
            <column name="mcp_credential_id" type="varchar(64)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="user_git_credentials" columnName="mcp_vault_id"/>
            <dropColumn tableName="user_git_credentials" columnName="mcp_credential_id"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
