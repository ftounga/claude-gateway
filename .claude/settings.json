{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-governance.sh\"",
            "timeout": 10,
            "statusMessage": "Garde-fou gouvernance (push --force / merge --squash)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/besoins-au-demarrage.sh\" 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Lecture des besoins en attente"
          }
        ]
      }
    ]
  }
}
