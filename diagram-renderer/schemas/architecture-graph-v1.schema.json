{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-gateway/schemas/architecture-graph-v1.schema.json",
  "title": "ArchitectureGraph v1 (F-238, cadrage §5.1)",
  "description": "Structure ET mise en page cadrée d'un schéma d'architecture, en pixels du SVG. Produit par diagram-renderer (cadre.js).",
  "type": "object",
  "required": ["version", "title", "direction", "bounds", "zones", "nodes", "edges", "notices"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "title": { "type": "string" },
    "direction": { "type": "string", "enum": ["LR", "TB"] },
    "bounds": { "$ref": "#/$defs/size" },
    "zones": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "parent", "depth", "box", "inferred"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["cloud", "account", "region", "vpc", "az", "subnet_public", "subnet_private", "asg", "security_group", "onprem", "generic"] },
          "label": { "type": "string" },
          "parent": { "type": "string" },
          "depth": { "type": "integer", "minimum": 0 },
          "box": { "$ref": "#/$defs/box" },
          "inferred": { "type": "boolean" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "required": ["id", "type", "resolved", "label", "zone", "family", "unknown", "box"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "resolved": { "type": ["string", "null"] },
          "label": { "type": "string" },
          "zone": { "type": "string" },
          "family": { "type": "string" },
          "unknown": { "type": "boolean" },
          "box": { "$ref": "#/$defs/box" }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "label", "bidirectional", "points", "labelBox"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "bidirectional": { "type": "boolean" },
          "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
          "labelBox": { "type": ["object", "null"] }
        }
      }
    },
    "notices": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "size": {
      "type": "object",
      "required": ["w", "h"],
      "properties": { "w": { "type": "number", "minimum": 0 }, "h": { "type": "number", "minimum": 0 } }
    },
    "box": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number", "minimum": 0 }, "h": { "type": "number", "minimum": 0 }
      }
    }
  }
}
