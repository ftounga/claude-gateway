<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      F-38 / SF-38-03 — Module runner autonome.
      Volontairement SANS parent Spring Boot et SANS POM réacteur racine : le runner est un
      client léger déposé sur la machine de l'utilisateur, indépendant du build du backend
      (le CI fait `cd backend && ./mvnw verify`, inchangé). Build : `cd runner && ./mvnw -q package`
      → fat-jar autonome `runner/target/claude-runner.jar`.
    -->
    <groupId>fr.claudegateway</groupId>
    <artifactId>claude-runner</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>claude-runner</name>
    <description>Runner d'exécution sur machine connectée (F-38)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.18.2</jackson.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <!-- JSON : lecture des réponses d'appairage et persistance locale du jeton. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>claude-runner</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <executions>
                    <!--
                        SF-38-22 — Le lanceur est compilé pour Java 8, tout le reste pour Java 21.
                        C'est la seule façon de dire « il vous faut Java 21 » à une JVM 8 : sur
                        celle-ci, aucune classe compilée en 21 ne se charge, donc la vérification ne
                        peut pas vivre dans le code applicatif — il n'est jamais atteint.
                    -->
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <excludes>
                                <exclude>**/RunnerLauncher.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-launcher-for-java8</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>8</release>
                            <includes>
                                <include>**/RunnerLauncher.java</include>
                            </includes>
                            <!-- La cible 8 est dépréciée sur un JDK 21 : l'avertissement est
                                 attendu, il n'annonce pas un défaut. -->
                            <showDeprecation>false</showDeprecation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!--
                F-81 / SF-81-01 — Jar MINCE, attaché sous le classifieur `thin`.

                Le module `contract-tests/` doit charger les classes du runner À CÔTÉ de celles du
                backend, dans une même JVM. Il ne peut pas le faire depuis le fat-jar : celui-ci
                embarque sa propre copie de Jackson, qui se retrouverait en double sur le chemin de
                classes avec celle de Spring Boot — deux versions de la même bibliothèque, la
                première trouvée gagnant. Exactement le genre de divergence silencieuse que F-81
                existe pour empêcher.

                Le jar mince ne contient que les classes du runner ; Jackson y redevient une
                dépendance déclarée, dont la version est alors arbitrée par un seul BOM.

                L'ARTEFACT PRINCIPAL EST INCHANGÉ : le fat-jar produit par shade reste
                `target/claude-runner.jar`, et c'est toujours lui que l'image, les paquets autonomes
                et `GET /runner/download` servent. Ce jar-ci s'ajoute, il ne remplace rien.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <!--
                            F-81 / SF-81-03 — La VERSION, dans le manifeste.

                            Le runner declare sa version dans sa trame `ready` en lisant
                            `Package.getImplementationVersion()`. Sans cette entree, cette lecture
                            rend null et le runner retombe sur sa constante de repli : TOUS les
                            postes annoncaient alors la meme version, quelle que soit la date de
                            leur binaire. Le champ existait ; il ne disait rien.
                        -->
                        <manifestEntries>
                            <Implementation-Title>${project.artifactId}</Implementation-Title>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>thin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>thin</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Fat-jar autonome (toutes deps incluses) + main-class exécutable. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fr.claudegateway.runner.RunnerLauncher</mainClass>
                                    <!-- shade REECRIT le manifeste : sans ces entrees, le fat-jar
                                         distribue perdrait la version que le jar mince porte, et
                                         c'est lui qui tourne sur la machine du client. -->
                                    <manifestEntries>
                                        <Implementation-Title>${project.artifactId}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
